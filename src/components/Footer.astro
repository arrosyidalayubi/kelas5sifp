---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 mt-auto transition-colors duration-300">
  <div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <div class="md:flex md:items-center md:justify-between">
      
      <!-- Kiri: Brand & Info -->
      <div class="flex justify-center md:justify-start mb-6 md:mb-0">
        <!-- Tambahkan text-center dan md:text-left di sini -->
        <div class="text-center md:text-left">
          
          <!-- Tambahkan class 'block' agar span penuh satu baris -->
          <span class="block text-xl font-bold text-slate-900 dark:text-white">03SIFP005</span>
          
          <!-- Hapus text-center dari sini karena sudah diwariskan dari div di atas -->
          <p class="mt-2 text-sm text-slate-500 dark:text-slate-400 max-w-sm">
            Ruang kolaborasi mahasiswa Program Studi Sistem Informasi. Membangun teknologi dari baris kode pertama.
          </p>
          
        </div>
      </div>
      
      <!-- Kanan: Links & Badge -->
      <div class="flex flex-col items-center md:items-end gap-4">
        <div class="flex space-x-6 text-sm text-slate-500 dark:text-slate-400">
          <a href="https://github.com/arrosyidalayubi" target="_blank" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
            GitHub Repository
          </a>
          <a href="https://www.instagram.com/sisteminformasi005/" target="_blank" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
            Hubungi Kami
          </a>
        </div>
        
        <!-- Tech Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-xs font-medium text-slate-600 dark:text-slate-300">
          <span>Powered by</span>
          <a href="https://astro.build/" target="_blank" class="hover:text-purple-500 dark:hover:text-purple-400 transition-colors">
            <span class="text-purple-500 font-bold">Astro</span>
          </a>
          <span>&</span>
          <a href="https://www.cloudflare.com/" target="_blank" class="hover:text-amber-500 dark:hover:text-amber-400 transition-colors">
            <span class="text-amber-500 font-bold">Cloudflare</span>
          </a>
        </div>
      </div>
      
    </div>
    
    <div class="mt-8 pt-8 border-t border-slate-200 dark:border-slate-800 flex justify-center">
      <p class="text-sm text-slate-400 dark:text-slate-500 text-center">
        &copy; {currentYear} Kelas 03SIFP005. All rights reserved.
      </p>
    </div>
  </div>
</footer>