---
// src/components/Hero.astro
// Di area frontmatter ini Anda bisa meng-import aset gambar lokal menggunakan astro:assets 
// import { Image } from 'astro:assets';
---

<section class="relative bg-white dark:bg-slate-900 overflow-hidden pt-24 pb-16 sm:pt-32 sm:pb-24 lg:pb-32 transition-colors duration-300">
  
  <!-- Ornamen Latar Belakang (Efek Glow/Blur asimetris) -->
  <div class="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80" aria-hidden="true">
    <div class="relative left-[calc(50%-11rem)] aspect-1155/678 w-144.5 -translate-x-1/2 rotate-30 bg-linear-to-tr from-blue-600 to-cyan-400 opacity-20 dark:opacity-30 sm:left-[calc(50%-30rem)] sm:w-288.75" style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"></div>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="lg:grid lg:grid-cols-12 lg:gap-16 items-center">
      
      <!-- Kolom Kiri: Konten Teks -->
      <div class="lg:col-span-6 text-center lg:text-left">
        
        <!-- Label/Badge Animasi -->
        <div class="inline-flex items-center rounded-full px-3 py-1 text-sm font-semibold text-blue-700 bg-blue-100 dark:bg-blue-900/30 dark:text-blue-300 mb-6 border border-blue-200 dark:border-blue-800/50">
          <span class="flex h-2 w-2 rounded-full bg-blue-600 animate-pulse mr-2"></span>
          Sistem Informasi - Semester 3
        </div>
        
        <!-- Headline Utama -->
        <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-5xl md:text-6xl lg:text-5xl xl:text-6xl">
          <span class="block">Menyelami Logika,</span>
          <!-- Teks Gradien -->
          <span class="block text-transparent bg-clip-text bg-linear-to-r from-blue-600 to-cyan-500">Membangun Sistem.</span>
        </h1>
        
        <!-- Sub-headline -->
        <p class="mt-6 max-w-2xl text-lg text-slate-600 dark:text-slate-300 mx-auto lg:mx-0">
          Selamat datang di portal resmi <strong class="font-semibold text-slate-900 dark:text-white">Kelas 03SIFP005</strong>. Kami adalah mahasiswa yang bersemangat mendokumentasikan perjalanan akademik, kolaborasi proyek IT, dan inovasi teknologi.
        </p>
        
        <!-- Area Tombol (Call to Action) -->
        <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
          <a href="/anggota" class="inline-flex justify-center items-center rounded-xl bg-blue-600 px-6 py-3.5 text-base font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-offset-2 focus-visible:outline-blue-600 transition-all duration-200 hover:-translate-y-0.5">
            Lihat Profil Kelas
            <svg class="ml-2 -mr-1 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
          <a href="/jadwal" class="inline-flex justify-center items-center rounded-xl bg-slate-100 dark:bg-slate-800 px-6 py-3.5 text-base font-semibold text-slate-900 dark:text-white hover:bg-slate-200 dark:hover:bg-slate-700 transition-all duration-200 ring-1 ring-inset ring-slate-300 dark:ring-slate-700 hover:-translate-y-0.5">
            Jadwal Kuliah
          </a>
        </div>
      </div>

      <!-- Kolom Kanan: Elemen Visual (Window Code Mockup) -->
      <div class="mt-16 sm:mt-24 lg:col-span-6 lg:mt-0">
        <!-- Frame Window -->
        <div class="relative mx-auto w-full max-w-lg rounded-2xl bg-slate-900 shadow-2xl ring-1 ring-white/10 lg:max-w-none transform transition-transform duration-500 hover:scale-[1.02]">
          
          <!-- Header Mockup Window (Mac OS style) -->
          <div class="flex items-center border-b border-slate-800 px-4 py-3 bg-slate-900/50 rounded-t-2xl">
            <div class="flex space-x-2">
              <div class="h-3 w-3 rounded-full bg-red-500"></div>
              <div class="h-3 w-3 rounded-full bg-yellow-500"></div>
              <div class="h-3 w-3 rounded-full bg-green-500"></div>
            </div>
            <div class="ml-4 text-xs text-slate-400 font-mono">03sifp005/config.js</div>
          </div>
          
          <!-- Konten Kode Mockup -->
          <div class="p-6 text-sm sm:text-base text-slate-300 font-mono overflow-hidden bg-slate-900 rounded-b-2xl">
            <div class="flex">
              <span class="text-slate-600 mr-4 select-none">1</span>
              <!-- UBAH BAGIAN INI: Ganti tanda { menjadi {"{"} -->
              <span><span class="text-pink-500">const</span> <span class="text-blue-400">kelas</span> <span class="text-cyan-400">=</span> {"{"}</span>
            </div>
            
            <div class="flex">
              <span class="text-slate-600 mr-4 select-none">2</span>
              <span class="ml-4 sm:ml-8">id: <span class="text-green-400">'03SIFP005'</span>,</span>
            </div>
            
            <div class="flex">
              <span class="text-slate-600 mr-4 select-none">3</span>
              <span class="ml-4 sm:ml-8">prodi: <span class="text-green-400">'Sistem Informasi'</span>,</span>
            </div>
            
            <div class="flex">
              <span class="text-slate-600 mr-4 select-none">4</span>
              <span class="ml-4 sm:ml-8">techStack: [<span class="text-green-400">'Astro'</span>, <span class="text-green-400">'Tailwind'</span>, <span class="text-green-400">'Cloudflare'</span>],</span>
            </div>
            
            <div class="flex">
              <span class="text-slate-600 mr-4 select-none">5</span>
              <span class="ml-4 sm:ml-8">isActive: <span class="text-yellow-300">true</span></span>
            </div>
            
            <div class="flex">
              <span class="text-slate-600 mr-4 select-none">6</span>
              <!-- UBAH BAGIAN INI: Ganti tanda }; menjadi {"}"}; -->
              <span>{"}"};</span>
            </div>
            
            <div class="flex mt-4">
              <span class="text-slate-600 mr-4 select-none">7</span>
              <span><span class="text-pink-500">console</span>.<span class="text-blue-400">log</span>(<span class="text-green-400">"Deploying to Pages..."</span>);</span>
            </div>
            
            <div class="flex">
              <span class="text-slate-600 mr-4 select-none">8</span>
              <span class="animate-pulse text-cyan-400">█</span>
            </div>
            
            <!-- Aksen Glow di dalam Mockup -->
            <div class="absolute -bottom-10 -right-10 h-40 w-40 rounded-full bg-blue-600 opacity-20 blur-3xl"></div>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>