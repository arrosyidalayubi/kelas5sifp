---
// src/layouts/Layout.astro
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  // Menambahkan properti deskripsi (opsional, ada nilai default-nya)
  description?: string;
  // Menambahkan gambar thumbnail untuk share WhatsApp/Telegram
  image?: string; 
}

// Menangkap URL halaman saat ini untuk Canonical URL
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://kelas5sifp.web.id');

// Nilai Default jika halaman tidak memberikan props
const { 
  title, 
  description = "Portal Resmi Kelas 03SIFP005 Program Studi Sistem Informasi. Mendokumentasikan perjalanan akademik dan proyek IT.",
  image = "/OpenGraph.jpg" // Pastikan Anda menaruh gambar thumbnail.jpg di folder /public
} = Astro.props;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/logo-unpam.png" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title} | 03SIFP005</title>
    <meta name="title" content={`${title} | 03SIFP005`} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | 03SIFP005`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={`${title} | 03SIFP005`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    <!-- Script Dark Mode Anda yang lama tetap di sini -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
      window.localStorage.setItem('theme', theme);
    </script>
  </head>
  
  <body class="bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-slate-100 transition-colors duration-300 flex flex-col min-h-screen antialiased">
    
    <!-- Memanggil Header -->
    <Header />

    <!-- Konten Halaman akan masuk ke slot ini -->
    <main class="grow">
      <slot />
    </main>

    <!-- Memanggil Footer -->
    <Footer />

  </body>
</html>