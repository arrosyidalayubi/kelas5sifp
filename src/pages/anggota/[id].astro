---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

interface Props {
  entry: CollectionEntry<'mahasiswa'>;
}

export async function getStaticPaths() {
  const mahasiswaEntries = await getCollection('mahasiswa');
  
  return mahasiswaEntries.map((entry: CollectionEntry<'mahasiswa'>) => ({
    // Gunakan id, bukan slug
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;

// Fungsi render() API terbaru Astro v7
const { Content } = await render(entry);
---

<Layout title={`Profil ${entry.data.name}`}
  description={`Lihat profil akademik dan portofolio ${entry.data.name} dari Program Studi Sistem Informasi kelas 03SIFP005.`}>
  <!-- Tombol Kembali -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-4">
    <a href="/anggota" class="inline-flex items-center text-sm font-medium text-slate-500 hover:text-blue-600 dark:text-slate-400 dark:hover:text-blue-400 transition-colors">
      <svg class="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Kembali ke Direktori
    </a>
  </div>

  <!-- Kontainer Profil -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
      
      <!-- Header / Cover Latar Belakang -->
      <div class="h-32 sm:h-48 bg-linear-to-r from-blue-600 to-cyan-500 w-full"></div>

      <!-- Area Detail Profil -->
      <div class="px-6 sm:px-10 pb-10">
        
        <div class="sm:flex sm:items-end sm:space-x-5 relative -mt-16 sm:-mt-24 mb-6">
          <!-- Foto Profil (Overlapping) -->
          <div class="relative inline-block">
            {entry.data.avatar ? (
              <Image 
                src={entry.data.avatar} 
                alt={`Foto ${entry.data.name}`} 
                class="h-32 w-32 sm:h-40 sm:w-40 rounded-full object-cover ring-8 ring-white dark:ring-slate-900 bg-white dark:bg-slate-900"
              />
            ) : (
              <img 
                src={`https://ui-avatars.com/api/?name=${encodeURIComponent(entry.data.name)}&background=eff6ff&color=1d4ed8&size=512&bold=true`}
                alt={`Avatar Inisial ${entry.data.name}`}
                class="h-32 w-32 sm:h-40 sm:w-40 rounded-full object-cover ring-8 ring-white dark:ring-slate-900 bg-white dark:bg-slate-900"
              />
            )}
            
            <!-- Status Indikator -->
            {entry.data.isActive && (
               <span class="absolute bottom-2 right-2 sm:bottom-4 sm:right-4 h-5 w-5 sm:h-6 sm:w-6 rounded-full bg-green-500 ring-4 ring-white dark:ring-slate-800" title="Mahasiswa Aktif"></span>
            )}
          </div>

          <!-- Nama -->
          <div class="mt-4 sm:mt-0 pt-2 sm:pb-4 flex-1">
            <h1 class="text-2xl sm:text-4xl font-bold text-slate-900 dark:text-white truncate">
              {entry.data.name}
            </h1>
          </div>
          
          <!-- Tombol Sosial Media (Hanya tampil jika ada data di markdown) -->
          {entry.data.socials && (
            <div class="mt-4 sm:mt-0 sm:pb-4 flex gap-3">
              {entry.data.socials.github && (
                <a href={entry.data.socials.github} target="_blank" class="p-2 rounded-lg bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 hover:text-blue-600 hover:bg-blue-50 dark:hover:text-blue-400 dark:hover:bg-slate-600 transition-colors">
                  <span class="sr-only">GitHub</span>
                  <!-- Icon GitHub SVG -->
                  <svg class="h-5 w-5 sm:h-6 sm:w-6" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" /></svg>
                </a>
              )}
            </div>
          )}
        </div>

        <!-- Role Badge -->
        <div class="mb-8">
          <span class="inline-flex items-center px-4 py-1.5 rounded-full text-sm font-medium bg-blue-50 text-blue-700 border border-blue-200 dark:bg-blue-900/30 dark:text-blue-300 dark:border-blue-800/50">
            💻 {entry.data.role}
          </span>
        </div>

        <!-- Render Konten Markdown (Bio/Portofolio) -->
        <!-- Class 'prose' sangat cocok jika Anda menginstall @tailwindcss/typography -->
        <div class="prose dark:prose-invert max-w-none prose-blue">
          <h2 class="text-xl font-bold text-slate-900 dark:text-white border-b border-slate-200 dark:border-slate-700 pb-2 mb-4">Tentang</h2>
          
          <div class="text-slate-600 dark:text-slate-300 leading-relaxed">
            <Content />
          </div>
        </div>

      </div>
    </div>
  </div>
</Layout>