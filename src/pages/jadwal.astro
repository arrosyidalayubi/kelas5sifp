---

<Layout title="Jadwal Kuliah">
  <div class="min-h-screen p-4 sm:p-8 pt-12 pb-24">
    <div class="max-w-7xl mx-auto">
      
      <!-- Header Section -->
      <div class="text-center mb-12">
        <div class="inline-flex items-center rounded-full px-3 py-1 text-sm font-semibold text-blue-700 bg-blue-100 dark:bg-blue-900/30 dark:text-blue-300 mb-4 border border-blue-200 dark:border-blue-800/50">
          Semester 3 - TA 2026/2027
        </div>
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-4">
          Jadwal Kuliah
        </h1>
        <p class="text-lg text-slate-600 dark:text-slate-400">
          Berikut adalah jadwal kuliah untuk Kelas 03SIFP005 Sistem Informasi. Hari ini adalah <strong id="teks-hari-ini" class="font-semibold text-blue-600 dark:text-blue-400 capitalize">hari ini</strong>.
        </p>
      </div>

      <!-- Grid Hari -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        
        {jadwalKuliah.map((jadwal) => (
          
          <div 
            class="jadwal-card relative rounded-3xl bg-white dark:bg-slate-800 shadow-sm border border-slate-200 dark:border-slate-700 hover:shadow-lg transition-all duration-300"
            data-hari={jadwal.hari.toLowerCase()}
          ><!-- Tambahkan atribut data-hari dan biarkan border standar -->
            
            <!-- Badge "Hari Ini" (Disembunyikan dengan class 'hidden' by default) -->
            <div class="badge-hari-ini hidden absolute -top-3 left-6 px-3 py-1 bg-blue-500 text-white text-xs font-bold rounded-full shadow-sm transition-all duration-300">
              Hari Ini
            </div>

            <!-- Header Kartu -->
            <div class="px-6 py-5 border-b border-slate-100 dark:border-slate-700/50">
              <h2 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <svg class="w-5 h-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                {jadwal.hari}
              </h2>
            </div>

              <!-- Daftar Mata Kuliah -->
              <div class="p-6">
                {jadwal.mataKuliah.length > 0 ? (
                  <div class="space-y-6">
                    {jadwal.mataKuliah.map((mk) => (
                      
                      <div class="mk-item relative pl-4 border-l-2 border-slate-200 dark:border-slate-700 transition-all duration-500" data-waktu={mk.waktu}>
                        <!-- TAMBAHAN: Class 'mk-item' dan atribut 'data-waktu' -->
                        <!-- TAMBAHAN: Class 'mk-dot' untuk mengubah warna titik -->
                        <div class="mk-dot absolute -left-1.25 top-1.5 h-2 w-2 rounded-full bg-blue-400 transition-colors duration-500"></div>
                        
                        <div class="flex flex-wrap items-start justify-between gap-2 mb-1">
                          <h3 class="font-bold text-slate-900 dark:text-slate-100 leading-tight">
                            {mk.nama}
                          </h3>
                          <span class={`inline-flex whitespace-nowrap px-2 py-0.5 rounded-md text-xs font-semibold border ${mk.warnaBadge}`}>
                            {mk.tipe}
                          </span>
                        </div>
                        
                        <div class="mt-2 space-y-1.5 text-sm text-slate-600 dark:text-slate-400">
                          <div class="flex items-center gap-2">
                            <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                            <span class="font-mono text-slate-700 dark:text-slate-300 font-medium">{mk.waktu}</span>
                          </div>
                          <!-- Sisa info ruang & dosen biarkan sama... -->
                          <div class="flex items-center gap-2">
                            <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                            <span>{mk.ruang}</span>
                          </div>
                          <div class="flex items-center gap-2">
                            <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                            <span>{mk.dosen}</span>
                          </div>
                        </div>
                      </div>
                    ))}
                  </div>
                ) : (
                  
                  <div class="flex flex-col items-center justify-center py-8 text-center opacity-70">
                    {/* State Kosong (Hari Libur) */}
                    <svg class="w-12 h-12 text-slate-300 dark:text-slate-600 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Tidak ada jadwal kuliah.</p>
                    <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Waktunya istirahat atau nugas!</p>
                  </div>
                )}
              </div>

            </div>
        ))}

      </div>
    </div>
  </div>
  <script>
  // Bungkus seluruh logika ke dalam sebuah fungsi utama
  function jalankanJadwal() {
    const date = new Date();
    const utcTime = date.getTime() + (date.getTimezoneOffset() * 60000);
    const jakartaTime = new Date(utcTime + (3600000 * 7));
    
    const hariIndex = jakartaTime.getDay();
    const namaHari = ["minggu", "senin", "selasa", "rabu", "kamis", "jumat", "sabtu"];
    const hariIniString = namaHari[hariIndex];

    // 1. Ubah Teks Paragraf di Atas
    const elemenTeksHari = document.getElementById('teks-hari-ini');
    if (elemenTeksHari) {
      elemenTeksHari.innerText = hariIniString;
    }

    // 2. Dapatkan Jam dan Menit (WIB) Saat Ini
    const currentHour = jakartaTime.getHours();
    const currentMinute = jakartaTime.getMinutes();
    const currentTimeDecimal = currentHour + (currentMinute / 60);

    // 3. Proses Kartu Jadwal
    const cards = document.querySelectorAll('.jadwal-card');
    
    cards.forEach((card) => {
      // Ambil nama hari dari kartu dan ubah ke huruf kecil
      const hariKartu = card.getAttribute('data-hari')?.toLowerCase();

      if (hariKartu === hariIniString) {
        // Beri Highlight pada Kartu
        card.classList.remove('border-slate-200', 'dark:border-slate-700', 'hover:shadow-lg');
        card.classList.add('border-blue-500', 'ring-1', 'ring-blue-500', 'shadow-blue-100', 'dark:shadow-blue-900/20');

        // Munculkan Badge
        const badge = card.querySelector('.badge-hari-ini');
        if (badge) badge.classList.remove('hidden');

        // 4. Proses Jam Mata Kuliah (Redupkan yang sudah terlewat)
        const mkItems = card.querySelectorAll('.mk-item');
        mkItems.forEach((item) => {
          const waktuString = item.getAttribute('data-waktu');
          
          if (waktuString) {
            const [waktuMulai, waktuSelesai] = waktuString.split('-');
            
            if (waktuSelesai) {
              const [jamSelesai, menitSelesai] = waktuSelesai.trim().split(':').map(Number);
              const endTimeDecimal = jamSelesai + (menitSelesai / 60);

              if (currentTimeDecimal >= endTimeDecimal) {
                item.classList.add('opacity-40', 'grayscale');
                const dot = item.querySelector('.mk-dot');
                if (dot) {
                  dot.classList.remove('bg-blue-400');
                  dot.classList.add('bg-slate-300', 'dark:bg-slate-700');
                }
              }
            }
          }
        });
      }
    });
  }

  // JALANKAN LANGSUNG: Ini menjamin skrip jalan di Astro mode standar
  jalankanJadwal();

  // (Opsional) Jalankan juga saat navigasi jika nanti pakai ViewTransitions
  document.addEventListener('astro:page-load', jalankanJadwal);
</script>
</Layout>